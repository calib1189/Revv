<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "development" here is the Xcode convention, not a mistake: the
	     provisioning profile decides the real value at signing time, so
	     an App Store / TestFlight archive is signed with "production". -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
