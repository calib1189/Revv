# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser or client-reachable code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Every paid feature (ads, meetup posting/promotion, shop
# promotion) stays fully disabled — no checkout UI shown — until this is
# set. Get it from the Stripe dashboard. Every price here is dynamic
# (Stripe price_data, set server-side per feature), so there's no fixed
# STRIPE_PRICE_ID to configure.
STRIPE_SECRET_KEY=
# From the Stripe CLI or the webhook endpoint's settings in the dashboard.
STRIPE_WEBHOOK_SECRET=

# Optional. Without this, AI vehicle identification, build ratings, and
# the REVV assistant all fall back to their mock providers (clearly
# labeled as mock in the UI, never invented data presented as real). Get
# a key from Google AI Studio (aistudio.google.com) — the free tier is
# rate-limited and not intended for production traffic, so enable
# billing on the associated Google Cloud project before real launch.
# Server-only — never expose this to the browser or client-reachable code.
GEMINI_API_KEY=

# Optional. Defaults to the current Vercel deployment URL if unset — only
# needed once a custom domain is set up, so absolute URLs (metadata,
# robots.txt, sitemap.xml) point at the real domain instead.
NEXT_PUBLIC_SITE_URL=

# Optional. Push notifications stay disabled (no opt-in UI shown) until
# both are set. Generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional. Every "search"/"buy" link on a modification stays a plain,
# untagged search until this is set — sign up free at
# affiliate-program.amazon.com to get one. NEXT_PUBLIC on purpose: an
# affiliate tag belongs in the URL, not a secret, and this same value is
# read both client-side (unmatched parts) and server-side (catalog-matched
# parts), so it only needs setting once.
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=

# Optional, and a separate approval gate from the tag above — Product
# Advertising API access usually requires your Associates account to
# have generated a few qualifying sales within 180 days of joining, so
# don't expect these to be available right when you sign up. Without
# them, marketplace category pages fall back to the plain tagged search
# link (no images/prices) — set all three once you're approved to show
# real Amazon product cards instead. Get them from the PA-API console at
# webservices.amazon.com/paapi5/documentation. Server-only — never
# expose these to the browser or client-reachable code.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=

# Optional. Without this, the Discover page's "Shops near you" tab shows
# an honest "not set up yet" empty state instead of any results — it
# never invents shop listings. Enable the "Places API (New)" in a Google
# Cloud project (console.cloud.google.com), then create an API key
# restricted to that API. Billing must be enabled on the project even
# within the free monthly credit; this endpoint charges per request, so
# it's worth restricting the key to just this API. Server-only — never
# expose this to the browser or client-reachable code.
GOOGLE_PLACES_API_KEY=

# Optional. Push notifications for the iOS app stay disabled (the mock
# provider sends nothing) until all three are set. From the Apple
# Developer account: Certificates, Identifiers & Profiles -> Keys -> "+",
# tick "Apple Push Notifications service (APNs)", and download the .p8
# (it can only be downloaded once). APNS_PRIVATE_KEY is the FULL contents
# of that file, including the BEGIN/END lines; if your host flattens
# newlines, literal 
 sequences are accepted. Server-only.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
# Optional. Defaults to com.sorza.app.
APNS_BUNDLE_ID=
# Optional. "production" (the default) is correct for TestFlight and the
# App Store. Only a build run straight from Xcode onto a device uses the
# "sandbox" endpoint.
APNS_ENVIRONMENT=
